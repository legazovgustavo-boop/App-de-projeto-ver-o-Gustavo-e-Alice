<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>A Firma - Barber Shop</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Plus Jakarta Sans', 'sans-serif'] },
                    colors: {
                        gold: { 400: '#D4AF37', 500: '#C5A028', 600: '#A38118' },
                        dark: { 800: '#121212', 900: '#0A0A0A', 950: '#050505' }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-dark-950 text-gray-100 min-h-screen flex flex-col font-sans">

    <!-- Header Coeso -->
    <header class="bg-dark-900 border-b border-gray-800 sticky top-0 z-50 shadow-lg">
        <div class="max-w-4xl mx-auto px-4 py-4 flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <div class="bg-gold-500 text-black p-2.5 rounded-xl font-bold text-xl shadow-md">
                    <i class="fa-solid fa-scissors"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg tracking-wider text-white">A FIRMA</h1>
                    <p class="text-xs text-gold-400 uppercase tracking-widest">Barber Shop</p>
                </div>
            </div>
            <!-- Botão da Área do Gerente -->
            <button id="btn-open-manager" class="text-xs bg-dark-800 hover:bg-gray-800 text-gold-400 border border-gray-700 px-3 py-2 rounded-xl transition flex items-center space-x-2 cursor-pointer z-50">
                <i class="fa-solid fa-user-shield"></i>
                <span>Área do Gerente</span>
            </button>
        </div>
    </header>

    <!-- Navegação Limpa -->
    <nav class="bg-dark-900 border-b border-gray-800">
        <div class="max-w-4xl mx-auto px-4 flex space-x-2 py-2">
            <button id="tab-btn-booking" class="flex-1 py-2.5 px-4 rounded-xl text-xs sm:text-sm font-semibold transition flex items-center justify-center space-x-2 bg-gold-500 text-black shadow">
                <i class="fa-solid fa-calendar-days"></i>
                <span>Agendar Horário</span>
            </button>
            <button id="tab-btn-appointments" class="flex-1 py-2.5 px-4 rounded-xl text-xs sm:text-sm font-semibold transition flex items-center justify-center space-x-2 text-gray-400 hover:text-white">
                <i class="fa-solid fa-clock-rotate-left"></i>
                <span>Meus Atendimentos</span>
            </button>
        </div>
    </nav>

    <!-- Conteúdo Principal -->
    <main class="flex-grow max-w-4xl w-full mx-auto p-4 sm:p-6 pb-24">

        <!-- TAB 1: AGENDAR -->
        <section id="content-booking" class="space-y-6">
            <div class="bg-dark-900 border border-gray-800 rounded-2xl p-5 sm:p-8 shadow-xl">
                <h2 class="text-xl font-bold text-white mb-1">Novo Agendamento</h2>
                <p class="text-xs text-gray-400 mb-6">Selecione o serviço, o profissional desejado e o horário.</p>
                
                <form id="appointmentForm" class="space-y-5">
                    <div>
                        <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-2">Serviço Desejado</label>
                        <select id="booking-service" required class="w-full bg-dark-800 border border-gray-700 rounded-xl p-3 text-white focus:outline-none focus:border-gold-400 transition">
                            <option value="" disabled selected>Selecione um serviço</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-2">Profissional Escolhido</label>
                        <select id="booking-barber" required class="w-full bg-dark-800 border border-gray-700 rounded-xl p-3 text-white focus:outline-none focus:border-gold-400 transition">
                            <option value="" disabled selected>Selecione o Barbeiro</option>
                        </select>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-2">Data</label>
                            <input type="date" id="booking-date" required class="w-full bg-dark-800 border border-gray-700 rounded-xl p-3 text-white focus:outline-none focus:border-gold-400 transition">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-2">Horário</label>
                            <select id="booking-time" required class="w-full bg-dark-800 border border-gray-700 rounded-xl p-3 text-white focus:outline-none focus:border-gold-400 transition">
                                <option value="" disabled selected>Selecione um horário</option>
                                <option value="09:00">09:00</option>
                                <option value="10:00">10:00</option>
                                <option value="11:00">11:00</option>
                                <option value="13:00">13:00</option>
                                <option value="14:00">14:00</option>
                                <option value="15:00">15:00</option>
                                <option value="16:00">16:00</option>
                                <option value="17:00">17:00</option>
                                <option value="18:00">18:00</option>
                                <option value="19:00">19:00</option>
                            </select>
                        </div>
                    </div>

                    <div class="border-t border-gray-800 pt-5 space-y-4">
                        <div>
                            <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-2">Seu Nome Completo</label>
                            <input type="text" id="client-name" placeholder="Ex: Lucas Silva" required class="w-full bg-dark-800 border border-gray-700 rounded-xl p-3 text-white placeholder-gray-500 focus:outline-none focus:border-gold-400 transition">
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-2">Telefone / WhatsApp</label>
                                <input type="tel" id="client-phone" placeholder="Ex: (11) 99999-9999" required class="w-full bg-dark-800 border border-gray-700 rounded-xl p-3 text-white placeholder-gray-500 focus:outline-none focus:border-gold-400 transition">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-2">E-mail para Confirmação</label>
                                <input type="email" id="client-email" placeholder="Ex: lucas@email.com" required class="w-full bg-dark-800 border border-gray-700 rounded-xl p-3 text-white placeholder-gray-500 focus:outline-none focus:border-gold-400 transition">
                            </div>
                        </div>
                    </div>

                    <!-- Política de Cancelamento -->
                    <div class="bg-dark-800/60 border border-gray-800 rounded-xl p-3 text-xs text-gray-400">
                        <i class="fa-solid fa-triangle-exclamation text-gold-400 mr-1"></i>
                        <strong>Política de Cancelamento:</strong> Permitido apenas com até <strong>1 hora de antecedência</strong> do horário agendado.
                    </div>

                    <button type="submit" class="w-full bg-gold-500 hover:bg-gold-600 text-black font-bold py-3.5 px-4 rounded-xl shadow-lg transition flex items-center justify-center space-x-2 text-base cursor-pointer">
                        <i class="fa-solid fa-check"></i>
                        <span>Confirmar Agendamento</span>
                    </button>
                </form>
            </div>
        </section>

        <!-- TAB 2: MEUS ATENDIMENTOS -->
        <section id="content-my-appointments" class="hidden space-y-6">
            <div class="bg-dark-900 border border-gray-800 rounded-2xl p-5 sm:p-8 shadow-xl">
                <h2 class="text-xl font-bold text-white mb-1">Meus Atendimentos</h2>
                <p class="text-xs text-gray-400 mb-6">Acompanhe seus horários ou cancele (respeitando o limite de 1h).</p>
                <div id="appointments-list" class="space-y-4"></div>
            </div>
        </section>

    </main>

    <!-- Modal / Painel do Gerente (Senha 1234) -->
    <div id="admin-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-dark-900 border border-gray-800 rounded-2xl w-full max-w-2xl p-6 shadow-2xl relative max-h-[90vh] overflow-y-auto">
            <button id="btn-close-modal" type="button" class="absolute top-4 right-4 text-gray-400 hover:text-white cursor-pointer">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>

            <!-- Login View -->
            <div id="admin-login-view">
                <h3 class="text-lg font-bold text-white mb-1"><i class="fa-solid fa-user-shield text-gold-400 mr-2"></i> Área do Gerente</h3>
                <p class="text-xs text-gray-400 mb-4">Acesso exclusivo da gerência (Senha: <strong>1234</strong>)</p>
                <input type="password" id="admin-pass" placeholder="Senha" class="w-full bg-dark-800 border border-gray-700 rounded-xl p-3 text-white mb-4 focus:outline-none focus:border-gold-400">
                <button id="btn-login-admin" type="button" class="w-full bg-gold-500 hover:bg-gold-600 text-black font-bold py-3 rounded-xl transition cursor-pointer">Entrar no Painel</button>
            </div>

            <!-- Dashboard View -->
            <div id="admin-dashboard-view" class="hidden space-y-6">
                <div class="border-b border-gray-800 pb-3 flex justify-between items-center">
                    <div>
                        <h3 class="text-lg font-bold text-white">Painel Administrativo - A Firma</h3>
                        <p class="text-xs text-gray-400">Gestão de equipe, valores e histórico de agendamentos.</p>
                    </div>
                    <button id="btn-logout-admin" type="button" class="text-xs bg-red-600/20 text-red-400 px-3 py-1.5 rounded-lg border border-red-500/30 cursor-pointer">Sair</button>
                </div>

                <!-- Gestão de Barbeiros (Equipe) -->
                <div class="bg-dark-800 border border-gray-700/50 rounded-xl p-4 space-y-3">
                    <div class="flex justify-between items-center">
                        <h4 class="font-bold text-sm text-gold-400"><i class="fa-solid fa-users mr-1"></i> Gestão da Equipe (Barbeiros)</h4>
                        <button id="btn-add-barber" type="button" class="text-xs bg-gold-500 text-black font-bold px-2.5 py-1 rounded-lg cursor-pointer">+ Adicionar Barbeiro</button>
                    </div>
                    <p class="text-xs text-gray-400">Adicione novos profissionais conforme a barbearia crescer.</p>
                    <div id="barbers-mgmt-list" class="space-y-2"></div>
                    <button id="btn-save-barbers" type="button" class="bg-gold-500 hover:bg-gold-600 text-black font-bold text-xs py-2 px-4 rounded-lg transition cursor-pointer">Salvar Equipe</button>
                </div>

                <!-- Manutenção de Valores -->
                <div class="bg-dark-800 border border-gray-700/50 rounded-xl p-4 space-y-3">
                    <h4 class="font-bold text-sm text-gold-400"><i class="fa-solid fa-tag mr-1"></i> Manutenção de Valores dos Serviços</h4>
                    <div id="services-price-list" class="space-y-3"></div>
                    <button id="btn-save-prices" type="button" class="bg-gold-500 hover:bg-gold-600 text-black font-bold text-xs py-2 px-4 rounded-lg transition cursor-pointer">Salvar Novos Preços</button>
                </div>

                <!-- Painel de Agendamentos (Histórico Completo) -->
                <div class="space-y-3">
                    <div class="flex justify-between items-center">
                        <h4 class="font-bold text-sm text-white"><i class="fa-solid fa-calendar-check mr-1 text-gold-400"></i> Histórico de Todos os Agendamentos</h4>
                        <span id="total-appointments-count" class="text-xs bg-dark-800 px-2.5 py-1 rounded-full text-gold-400 border border-gray-700">0 agendamentos</span>
                    </div>
                    <div id="admin-appointments-list" class="space-y-3 max-h-60 overflow-y-auto pr-1"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Script Principal -->
    <script>
        const defaultServices = [
            { id: 'fade', name: 'Corte com Fade/Degradê', price: 45.00 },
            { id: 'barba', name: 'Barba', price: 35.00 },
            { id: 'combo', name: 'Corte + Barba', price: 75.00 },
            { id: 'pezinho', name: 'Pezinho', price: 20.00 },
            { id: 'maquina', name: 'Máquina Única', price: 30.00 },
            { id: 'sobrancelha', name: 'Sobrancelha', price: 20.00 }
        ];

        const defaultBarbers = [
            { name: 'Barbeiro Principal' }
        ];

        function getServices() {
            const data = localStorage.getItem('afirma_services');
            return data ? JSON.parse(data) : defaultServices;
        }

        function getBarbers() {
            const data = localStorage.getItem('afirma_barbers');
            return data ? JSON.parse(data) : defaultBarbers;
        }

        function renderServiceOptions() {
            const services = getServices();
            const select = document.getElementById('booking-service');
            if (select) {
                select.innerHTML = '<option value="" disabled selected>Selecione um serviço</option>' + 
                    services.map(s => `<option value="${s.name}|${s.price.toFixed(2)}">${s.name} - R$ ${s.price.toFixed(2).replace('.', ',')}</option>`).join('');
            }
        }

        function renderBarberOptions() {
            const barbers = getBarbers();
            const select = document.getElementById('booking-barber');
            if (select) {
                select.innerHTML = '<option value="" disabled selected>Selecione o Barbeiro</option>' + 
                    barbers.map(b => `<option value="${b.name}">${b.name}</option>`).join('');
            }
        }

        document.addEventListener("DOMContentLoaded", function() {
            renderServiceOptions();
            renderBarberOptions();

            const dateInput = document.getElementById('booking-date');
            if (dateInput) {
                dateInput.min = new Date().toISOString().split('T')[0];
            }

            // Abas
            document.getElementById('tab-btn-booking').addEventListener('click', () => switchTab('booking'));
            document.getElementById('tab-btn-appointments').addEventListener('click', () => switchTab('my-appointments'));

            // Gerência
            document.getElementById('btn-open-manager').addEventListener('click', openManagerModal);
            document.getElementById('btn-close-modal').addEventListener('click', toggleAdminModal);
            document.getElementById('btn-login-admin').addEventListener('click', checkAdminPassword);
            document.getElementById('btn-logout-admin').addEventListener('click', logoutAdmin);
            document.getElementById('btn-save-prices').addEventListener('click', saveServicePrices);
            document.getElementById('btn-add-barber').addEventListener('click', addBarber);
            document.getElementById('btn-save-barbers').addEventListener('click', saveBarbers);

            document.getElementById('appointmentForm').addEventListener('submit', handleBooking);
        });

        function switchTab(tabId) {
            const contentBooking = document.getElementById('content-booking');
            const contentAppointments = document.getElementById('content-my-appointments');
            const tabBooking = document.getElementById('tab-btn-booking');
            const tabAppointments = document.getElementById('tab-btn-appointments');

            if (tabId === 'booking') {
                if (contentBooking) contentBooking.classList.remove('hidden');
                if (contentAppointments) contentAppointments.classList.add('hidden');
                if (tabBooking) tabBooking.className = "flex-1 py-2.5 px-4 rounded-xl text-xs sm:text-sm font-semibold transition flex items-center justify-center space-x-2 bg-gold-500 text-black shadow";
                if (tabAppointments) tabAppointments.className = "flex-1 py-2.5 px-4 rounded-xl text-xs sm:text-sm font-semibold transition flex items-center justify-center space-x-2 text-gray-400 hover:text-white";
            } else {
                if (contentBooking) contentBooking.classList.add('hidden');
                if (contentAppointments) contentAppointments.classList.remove('hidden');
                if (tabBooking) tabBooking.className = "flex-1 py-2.5 px-4 rounded-xl text-xs sm:text-sm font-semibold transition flex items-center justify-center space-x-2 text-gray-400 hover:text-white";
                if (tabAppointments) tabAppointments.className = "flex-1 py-2.5 px-4 rounded-xl text-xs sm:text-sm font-semibold transition flex items-center justify-center space-x-2 bg-gold-500 text-black shadow";
                renderAppointments();
            }
        }

        function getAppointments() {
            const data = localStorage.getItem('afirma_appointments');
            return data ? JSON.parse(data) : [];
        }

        function handleBooking(e) {
            e.preventDefault();
            const serviceVal = document.getElementById('booking-service').value;
            if (!serviceVal) {
                alert('Por favor, selecione um serviço.');
                return;
            }
            const serviceSelect = serviceVal.split('|');
            const serviceName = serviceSelect[0];
            const servicePrice = serviceSelect[1];
            const barber = document.getElementById('booking-barber').value;
            const date = document.getElementById('booking-date').value;
            const time = document.getElementById('booking-time').value;
            const clientName = document.getElementById('client-name').value;
            const clientPhone = document.getElementById('client-phone').value;
            const clientEmail = document.getElementById('client-email').value;

            const newApp = {
                id: Date.now(),
                serviceName,
                servicePrice,
                barber,
                date,
                time,
                clientName,
                clientPhone,
                clientEmail,
                createdAt: new Date().toISOString()
            };

            let appointments = getAppointments();
            appointments.push(newApp);
            localStorage.setItem('afirma_appointments', JSON.stringify(appointments));

            // E-mail automático para o cliente
            const emailSubject = encodeURIComponent(`Confirmação de Agendamento - A Firma Barber Shop`);
            const emailBody = encodeURIComponent(`Olá ${clientName},\n\nSeu agendamento na A Firma foi confirmado com sucesso!\n\nDetalhes:\n- Serviço: ${serviceName} (R$ ${servicePrice})\n- Profissional: ${barber}\n- Data: ${formatDate(date)} às ${time}\n\nAgradecemos a preferência!`);
            
            window.location.href = `mailto:${clientEmail}?subject=${emailSubject}&body=${emailBody}`;

            alert(`Agendamento realizado com sucesso!\n\n- E-mail de confirmação enviado para ${clientEmail}.\n- O profissional ${barber} foi notificado no painel da gerência.`);

            document.getElementById('appointmentForm').reset();
            const dateInput = document.getElementById('booking-date');
            if (dateInput) dateInput.min = new Date().toISOString().split('T')[0];
            switchTab('my-appointments');
        }

        function cancelAppointment(id, dateStr, timeStr) {
            const appointmentDateTime = new Date(`${dateStr}T${timeStr}:00`);
            const now = new Date();
            const diffMs = appointmentDateTime - now;
            const diffHours = diffMs / (1000 * 60 * 60);

            if (diffHours < 1) {
                alert('Aviso: O cancelamento não é permitido com menos de 1 hora de antecedência do horário agendado.');
                return;
            }

            if(confirm('Deseja realmente cancelar este atendimento?')) {
                let appointments = getAppointments();
                appointments = appointments.filter(app => app.id !== id);
                localStorage.setItem('afirma_appointments', JSON.stringify(appointments));
                renderAppointments();
                alert('Atendimento cancelado com sucesso.');
            }
        }

        function renderAppointments() {
            const listContainer = document.getElementById('appointments-list');
            const appointments = getAppointments();

            if (!listContainer) return;

            if (appointments.length === 0) {
                listContainer.innerHTML = '<div class="text-center py-8 text-gray-500 text-sm">Nenhum atendimento agendado encontrado.</div>';
                return;
            }

            listContainer.innerHTML = appointments.map(app => {
                return `
                    <div class="bg-dark-800 border border-gray-700/50 rounded-xl p-4 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
                        <div>
                            <div class="flex items-center space-x-2">
                                <span class="text-gold-400 font-bold text-sm">${app.serviceName}</span>
                                <span class="text-xs bg-dark-900 px-2 py-0.5 rounded text-gray-300 border border-gray-700">R$ ${app.servicePrice}</span>
                            </div>
                            <p class="text-xs text-gray-300 mt-1"><i class="fa-solid fa-user-tie text-gold-400 mr-1"></i> Profissional: <strong>${app.barber}</strong></p>
                            <p class="text-xs text-gray-400"><i class="fa-solid fa-calendar text-gold-400 mr-1"></i> ${formatDate(app.date)} às ${app.time}</p>
                            <p class="text-xs text-gray-500 mt-1">Contato: ${app.clientPhone} | E-mail: ${app.clientEmail}</p>
                        </div>
                        <div class="flex items-center space-x-2 w-full sm:w-auto justify-end">
                            <a href="https://api.whatsapp.com/send?phone=5511999999999&text=Olá,%20gostaria%20de%20confirmar%20meu%20agendamento%20de%20${encodeURIComponent(app.serviceName)}%20com%20${encodeURIComponent(app.barber)}%20para%20o%20dia%20${app.date}%20às%20${app.time}." target="_blank" class="bg-green-600 hover:bg-green-700 text-white text-xs px-3 py-2 rounded-lg font-semibold flex items-center space-x-1 transition">
                                <i class="fa-brands fa-whatsapp"></i>
                                <span>WhatsApp</span>
                            </a>
                            <button type="button" onclick="cancelAppointment(${app.id}, '${app.date}', '${app.time}')" class="bg-red-600/20 hover:bg-red-600/30 text-red-400 text-xs px-3 py-2 rounded-lg font-semibold border border-red-500/30 transition cursor-pointer">
                                Cancelar
                            </button>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function formatDate(dateStr) {
            const parts = dateStr.split('-');
            return parts.length === 3 ? `${parts[2]}/${parts[1]}/${parts[0]}` : dateStr;
        }

        function openManagerModal() {
            const modal = document.getElementById('admin-modal');
            if (modal) {
                modal.classList.remove('hidden');
                const passInput = document.getElementById('admin-pass');
                if (passInput) passInput.value = '';
                document.getElementById('admin-login-view').classList.remove('hidden');
                document.getElementById('admin-dashboard-view').classList.add('hidden');
            }
        }

        function toggleAdminModal() {
            document.getElementById('admin-modal').classList.add('hidden');
        }

        function checkAdminPassword() {
            const pass = document.getElementById('admin-pass').value;
            if(pass === '1234') {
                document.getElementById('admin-login-view').classList.add('hidden');
                document.getElementById('admin-dashboard-view').classList.remove('hidden');
                renderAdminDashboard();
            } else {
                alert('Senha incorreta! (A senha padrão é 1234)');
            }
        }

        function logoutAdmin() {
            document.getElementById('admin-login-view').classList.remove('hidden');
            document.getElementById('admin-dashboard-view').classList.add('hidden');
            document.getElementById('admin-pass').value = '';
        }

        function renderAdminDashboard() {
            renderBarbersMgmt();
            renderServicesMgmt();
            renderAdminAppointmentsList();
        }

        function renderBarbersMgmt() {
            const barbers = getBarbers();
            const container = document.getElementById('barbers-mgmt-list');
            if (!container) return;

            container.innerHTML = barbers.map((b, index) => `
                <div class="flex items-center justify-between bg-dark-900 p-2.5 rounded-lg border border-gray-700 text-xs">
                    <input type="text" id="barber-name-${index}" value="${b.name}" class="bg-dark-800 border border-gray-700 text-white p-1.5 rounded flex-grow mr-2">
                    <button type="button" onclick="removeBarber(${index})" class="text-red-400 hover:text-red-300 px-2 py-1 cursor-pointer"><i class="fa-solid fa-trash"></i></button>
                </div>
            `).join('');
        }

        function addBarber() {
            let barbers = getBarbers();
            barbers.push({ name: 'Novo Barbeiro' });
            localStorage.setItem('afirma_barbers', JSON.stringify(barbers));
            renderBarbersMgmt();
            renderBarberOptions();
        }

        function removeBarber(index) {
            let barbers = getBarbers();
            if (barbers.length <= 1) {
                alert('A barbearia precisa ter pelo menos um barbeiro cadastrado.');
                return;
            }
            barbers.splice(index, 1);
            localStorage.setItem('afirma_barbers', JSON.stringify(barbers));
            renderBarbersMgmt();
            renderBarberOptions();
        }

        function saveBarbers() {
            const barbers = getBarbers();
            const updated = barbers.map((b, index) => {
                const nameEl = document.getElementById(`barber-name-${index}`);
                return { name: nameEl ? nameEl.value : b.name };
            });
            localStorage.setItem('afirma_barbers', JSON.stringify(updated));
            renderBarberOptions();
            alert('Equipe atualizada com sucesso!');
        }

        function renderServicesMgmt() {
            const services = getServices();
            const servicesContainer = document.getElementById('services-price-list');
            
            if (servicesContainer) {
                servicesContainer.innerHTML = services.map((s, index) => `
                    <div class="flex items-center justify-between bg-dark-900 p-2.5 rounded-lg border border-gray-700 text-xs">
                        <span class="text-white font-medium">${s.name} (R$)</span>
                        <input type="number" step="0.50" id="service-price-${index}" value="${s.price.toFixed(2)}" class="bg-dark-800 border border-gray-700 text-gold-400 font-bold p-1.5 rounded w-24 text-center focus:outline-none focus:border-gold-400">
                    </div>
                `).join('');
            }
        }

        function saveServicePrices() {
            const services = getServices();
            services.forEach((s, index) => {
                const inputEl = document.getElementById(`service-price-${index}`);
                if (inputEl) {
                    const val = parseFloat(inputEl.value);
                    if (!isNaN(val)) {
                        s.price = val;
                    }
                }
            });
            localStorage.setItem('afirma_services', JSON.stringify(services));
            renderServiceOptions();
            alert('Valores dos serviços atualizados com sucesso!');
        }

        function renderAdminAppointmentsList() {
            const container = document.getElementById('admin-appointments-list');
            const appointments = getAppointments();
            const countEl = document.getElementById('total-appointments-count');
            if (countEl) countEl.innerText = `${appointments.length} agendamentos`;

            if (!container) return;

            if(appointments.length === 0) {
                container.innerHTML = '<div class="text-center py-6 text-gray-500 text-xs">Nenhum agendamento registado no sistema.</div>';
                return;
            }

            container.innerHTML = appointments.map(app => `
                <div class="bg-dark-900 border border-gray-700/50 rounded-xl p-3 text-xs space-y-1">
                    <div class="flex justify-between items-center font-bold text-white">
                        <span><i class="fa-solid fa-user text-gold-400 mr-1"></i> ${app.clientName}</span>
                        <span class="text-gold-400">R$ ${app.servicePrice}</span>
                    </div>
                    <p class="text-gray-300">Serviço: <strong>${app.serviceName}</strong> | Profissional: <strong class="text-gold-400">${app.barber}</strong></p>
                    <p class="text-gray-400">Data e Horário: <strong>${formatDate(app.date)} às ${app.time}</strong></p>
                    <p class="text-gray-500">Contato: Tel: ${app.clientPhone} | E-mail: ${app.clientEmail}</p>
                </div>
            `).join('');
        }
    </script>
</body>
</html>
